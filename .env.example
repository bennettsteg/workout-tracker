# Postgres connection string, read by the app, the migrate step and the Prisma CLI.
# docker-compose.yml passes this value straight through and does NOT define a Postgres
# service: the app joins an external `database-network` and expects a Postgres container
# that runs separately (the existing home-server instance), with a NEW database created on
# it for this app, e.g.:
# postgresql://<user>:<password>@<postgres-container>:5432/<database>?schema=public
# The value below is for local `npm run dev` / `prisma` CLI usage against Postgres on localhost.
DATABASE_URL="postgresql://workout:workout@localhost:5432/workout_tracker?schema=public"
